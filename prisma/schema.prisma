
generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
model Permiso {
  id          String       @id @default(uuid())
  nombre      String       @unique
  descripcion String
  createAt    DateTime     @default(now())
  updateAt    DateTime     @updatedAt
  activo      Boolean
  roles       RolPermiso[]
}

model RolPermiso {
  id        String   @id @default(uuid())
  rolId     String
  permisoId String
  createAt  DateTime @default(now())

  permiso Permiso @relation(fields: [permisoId], references: [id])
  rol     Rol     @relation(fields: [rolId], references: [id])

  @@unique([rolId, permisoId])
  @@index([permisoId], map: "RolPermiso_permisoId_fkey")
}

model Rol {
  id          String       @id @default(uuid())
  nombre      String       @unique
  descripcion String
  createAt    DateTime     @default(now())
  updateAt    DateTime     @updatedAt
  activo      Boolean
  permisos    RolPermiso[]
  usuarios    Usuarios[]
}

model Usuarios {
  id                  String               @id @db.VarChar(36)
  usuario             String               @db.VarChar(50)
  contrasena          String               @db.LongText
  nombre              String?              @db.VarChar(100)
  fotoUrl             String?              @db.VarChar(512)
  direccion           String?              @db.VarChar(180)
  telefono            String?              @db.VarChar(30)
  ciudad              String?              @db.VarChar(100)
  DebeCambiarPassword Boolean?
  email               String               @unique
  createAt            DateTime             @default(now())
  updateAt            DateTime             @updatedAt
  rol_id              String               @db.VarChar(36)
  activo              Boolean              @db.Bit(1)
  rol                 Rol                  @relation(fields: [rol_id], references: [id])
  PasswordResetToken  PasswordResetToken[]
  clientesAsignados   Cliente[]           @relation("UsuarioClientes")
  ventas              Venta[]             @relation("UsuarioVentas")
  productos           Producto[]          @relation("UsuarioProductos")
  notas               Nota[]
  tareas              Tarea[]
  ultimoInicioSesion  DateTime?
  ultimaActividad     DateTime?
  estaOnline          Boolean              @default(false)
  adminPadreId        String?              @db.VarChar(36)
  adminPadre          Usuarios?            @relation("AdminVendedores", fields: [adminPadreId], references: [id])
  vendedores          Usuarios[]           @relation("AdminVendedores")

  @@index([rol_id], map: "IX_Usuarios_rol_id")
  @@index([adminPadreId], map: "IX_Usuarios_adminPadreId")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @db.VarChar(36)
  token     String   @unique @db.VarChar(128)
  expiresAt DateTime
  createdAt DateTime @default(now())

  Usuario Usuarios @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "IX_PasswordResetToken_userId")
}


enum EtiquetaCliente {
  NUEVO
  INTERESADO
  CLIENTE
  MAYORISTA
}

enum EstadoVenta {
  PROCESO
  ENVIO
  ENTREGADA
}

enum EstadoTarea {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
}

enum TipoPrecioVenta {
  NORMAL
  DESCUENTO_10
  DESCUENTO_15
  DESCUENTO_20
  DESCUENTO_30
}

enum MetodoPagoVenta {
  EFECTIVO
  TRANSFERENCIA
}

enum TipoDocumentoVenta {
  RECIBO
  FACTURA
}

model Cliente {
  id               String          @id @default(uuid())
  nombre           String
  apellido         String
  ciudad           String
  correo           String          @unique
  numero           String
  direccion        String
  etiqueta         EtiquetaCliente @default(NUEVO)
  usuarioAsignadoId String         @db.VarChar(36)
  createAt         DateTime        @default(now())
  updateAt         DateTime        @updatedAt
  activo           Boolean         @default(true)

  usuarioAsignado  Usuarios        @relation("UsuarioClientes", fields: [usuarioAsignadoId], references: [id])
  ventas           Venta[]
  notas            Nota[]

  @@index([usuarioAsignadoId], map: "IX_Cliente_usuarioAsignadoId")
}

model Producto {
  id            String          @id @default(uuid())
  nombre        String
  descripcion   String
  stock         Int             @default(0)
  stockMinimo   Int             @default(0)
  activo        Boolean         @default(true)
  creadoPorId   String          @db.VarChar(36)
  createAt      DateTime        @default(now())
  updateAt      DateTime        @updatedAt

  creadoPor      Usuarios       @relation("UsuarioProductos", fields: [creadoPorId], references: [id])
  ventas         VentaProducto[]
  tareasObjetivo TareaProducto[]

  @@index([creadoPorId], map: "IX_Producto_creadoPorId")
}

model Venta {
  id        String     @id @default(uuid())
  clienteId String
  usuarioId String     @db.VarChar(36)
  total     Decimal    @db.Decimal(10, 2)
  isv       Decimal    @default(0) @db.Decimal(10, 2)
  tipoDocumento TipoDocumentoVenta @default(RECIBO)
  conEnvio  Boolean    @default(false)
  envio     Decimal    @default(0) @db.Decimal(10, 2)
  estado    EstadoVenta @default(PROCESO)
  metodoPago MetodoPagoVenta @default(EFECTIVO)
  evidenciaTransferenciaUbicacion String? @db.VarChar(1024)
  evidenciaTransferenciaNombre    String? @db.VarChar(255)
  createAt  DateTime   @default(now())
  updateAt  DateTime   @updatedAt

  cliente   Cliente    @relation(fields: [clienteId], references: [id])
  usuario   Usuarios   @relation("UsuarioVentas", fields: [usuarioId], references: [id])
  productos VentaProducto[]

  @@index([clienteId], map: "IX_Venta_clienteId")
  @@index([usuarioId], map: "IX_Venta_usuarioId")
}

model VentaProducto {
  id             String   @id @default(uuid())
  ventaId        String
  productoId     String
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
  tipoPrecio     TipoPrecioVenta @default(NORMAL)
  createAt       DateTime @default(now())

  venta          Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto       Producto @relation(fields: [productoId], references: [id])

  @@index([ventaId], map: "IX_VentaProducto_ventaId")
  @@index([productoId], map: "IX_VentaProducto_productoId")
}


model Nota {
  id         String    @id @default(uuid())
  clienteId  String
  usuarioId  String    @db.VarChar(36)
  contenido  String    @db.LongText
  createAt   DateTime  @default(now())
  updateAt   DateTime  @updatedAt

  cliente    Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuario    Usuarios  @relation(fields: [usuarioId], references: [id])
  evidencias NotaEvidencia[]
  tareas     Tarea[]

  @@index([clienteId], map: "IX_Nota_clienteId")
  @@index([usuarioId], map: "IX_Nota_usuarioId")
}



model Tarea {
  id          String      @id @default(uuid())
  notaId       String
  usuarioId    String      @db.VarChar(36)
  titulo       String
  descripcion  String?     @db.LongText
  fechaObjetivo DateTime
  estado       EstadoTarea @default(PENDIENTE)
  createAt     DateTime    @default(now())
  updateAt     DateTime    @updatedAt

  nota         Nota        @relation(fields: [notaId], references: [id], onDelete: Cascade)
  usuario      Usuarios    @relation(fields: [usuarioId], references: [id])
  productosObjetivo TareaProducto[]

  @@index([notaId], map: "IX_Tarea_notaId")
  @@index([usuarioId], map: "IX_Tarea_usuarioId")
  @@index([fechaObjetivo], map: "IX_Tarea_fechaObjetivo")
}

model NotaEvidencia {
  id        String   @id @default(uuid())
  notaId    String
  ubicacion String?  @db.VarChar(1024)
  nombre    String?  @db.VarChar(255)
  createAt  DateTime @default(now())

  nota Nota @relation(fields: [notaId], references: [id], onDelete: Cascade)

  @@index([notaId], map: "IX_NotaEvidencia_notaId")
}

model TareaProducto {
  id               String   @id @default(uuid())
  tareaId          String
  productoId       String
  cantidadObjetivo Int
  createAt         DateTime @default(now())

  tarea            Tarea    @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  producto         Producto @relation(fields: [productoId], references: [id])

  @@index([tareaId], map: "IX_TareaProducto_tareaId")
  @@index([productoId], map: "IX_TareaProducto_productoId")
}
