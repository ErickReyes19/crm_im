
generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
model Permiso {
  id          String       @id @default(uuid())
  nombre      String       @unique
  descripcion String
  createAt    DateTime     @default(now())
  updateAt    DateTime     @updatedAt
  activo      Boolean
  roles       RolPermiso[]
}

model RolPermiso {
  id        String   @id @default(uuid())
  rolId     String
  permisoId String
  createAt  DateTime @default(now())

  permiso Permiso @relation(fields: [permisoId], references: [id])
  rol     Rol     @relation(fields: [rolId], references: [id])

  @@unique([rolId, permisoId])
  @@index([permisoId], map: "RolPermiso_permisoId_fkey")
}

model Rol {
  id          String       @id @default(uuid())
  nombre      String       @unique
  descripcion String
  createAt    DateTime     @default(now())
  updateAt    DateTime     @updatedAt
  activo      Boolean
  permisos    RolPermiso[]
  usuarios    Usuarios[]
}

model Usuarios {
  id                  String               @id @db.VarChar(36)
  usuario             String               @db.VarChar(50)
  contrasena          String               @db.LongText
  nombre              String?              @db.VarChar(100)
  fotoUrl             String?              @db.VarChar(512)
  direccion           String?              @db.VarChar(180)
  telefono            String?              @db.VarChar(30)
  ciudad              String?              @db.VarChar(100)
  DebeCambiarPassword Boolean?
  email               String               @unique
  createAt            DateTime             @default(now())
  updateAt            DateTime             @updatedAt
  rol_id              String               @db.VarChar(36)
  activo              Boolean              @db.Bit(1)
  rol                 Rol                  @relation(fields: [rol_id], references: [id])
  PasswordResetToken  PasswordResetToken[]
  clientesAsignados   Cliente[]           @relation("UsuarioClientes")
  ventas              Venta[]             @relation("UsuarioVentas")
  tareasAsignadas     Tarea[]             @relation("UsuarioTareasAsignadas")
  tareasCreadas       Tarea[]             @relation("UsuarioTareasCreadas")

  @@index([rol_id], map: "IX_Usuarios_rol_id")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @db.VarChar(36)
  token     String   @unique @db.VarChar(128)
  expiresAt DateTime
  createdAt DateTime @default(now())

  Usuario Usuarios @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "IX_PasswordResetToken_userId")
}


enum EtiquetaCliente {
  NUEVO
  INTERESADO
}

enum EstadoVenta {
  PROCESO
  ENVIO
  ENTREGADA
}

enum EstadoTarea {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
}

model Cliente {
  id               String          @id @default(uuid())
  nombre           String
  apellido         String
  ciudad           String
  correo           String          @unique
  numero           String
  direccion        String
  etiqueta         EtiquetaCliente @default(NUEVO)
  usuarioAsignadoId String         @db.VarChar(36)
  createAt         DateTime        @default(now())
  updateAt         DateTime        @updatedAt
  activo           Boolean         @default(true)

  usuarioAsignado  Usuarios        @relation("UsuarioClientes", fields: [usuarioAsignadoId], references: [id])
  ventas           Venta[]

  @@index([usuarioAsignadoId], map: "IX_Cliente_usuarioAsignadoId")
}

model Venta {
  id        String     @id @default(uuid())
  clienteId String
  usuarioId String     @db.VarChar(36)
  total     Decimal    @db.Decimal(10, 2)
  estado    EstadoVenta @default(PROCESO)
  createAt  DateTime   @default(now())
  updateAt  DateTime   @updatedAt

  cliente   Cliente    @relation(fields: [clienteId], references: [id])
  usuario   Usuarios   @relation("UsuarioVentas", fields: [usuarioId], references: [id])

  @@index([clienteId], map: "IX_Venta_clienteId")
  @@index([usuarioId], map: "IX_Venta_usuarioId")
}

model Tarea {
  id               String      @id @default(uuid())
  nombre           String
  descripcion      String
  estado           EstadoTarea @default(PENDIENTE)
  fechaFinalizacion DateTime
  asignadoAId      String      @db.VarChar(36)
  asignadoPorId    String      @db.VarChar(36)
  createAt         DateTime    @default(now())
  updateAt         DateTime    @updatedAt

  asignadoA        Usuarios    @relation("UsuarioTareasAsignadas", fields: [asignadoAId], references: [id])
  asignadoPor      Usuarios    @relation("UsuarioTareasCreadas", fields: [asignadoPorId], references: [id])

  @@index([asignadoAId], map: "IX_Tarea_asignadoAId")
  @@index([asignadoPorId], map: "IX_Tarea_asignadoPorId")
}
